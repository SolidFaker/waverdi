$upscope $end
$scope module u_ram $end
$var reg 8 * addr [7:0] $end
$var reg 32 + wdata [31:0] $end
$var wire 1 , we $end
$var reg 32 - rdata [31:0] $end
$var wire 8 . dq [7:0] $end
$upscope $end
$scope module u_sensor $end
$var real 64 / temp $end
$upscope $end
$var string 80 : msg $end
$upscope $end
$enddefinitions $end
